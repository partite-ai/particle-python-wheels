--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -4,7 +4,15 @@
 
 add_extension_definitions()
 
-if (NOT EMSCRIPTEN)
+# wasm32-wasip2: the wasi-sdk toolchain sets CMAKE_SYSTEM_NAME=WASI. We build
+# httpfs like the EMSCRIPTEN target — no curl, no openssl, only core's
+# vendored mbedtls (S3-signing hashes; NOT TLS, which wasi:http does on the
+# host) — plus a wasi:http-backed transport (src/wasi_http_client.cpp).
+if(CMAKE_SYSTEM_NAME STREQUAL "WASI")
+  set(HTTPFS_WASI TRUE)
+endif()
+
+if (NOT EMSCRIPTEN AND NOT HTTPFS_WASI)
   add_definitions(-DOVERRIDE_ENCRYPTION_UTILS=1)
 else()
   set(DUCKDB_EXTENSION_HTTPFS_LINKED_LIBS "../../third_party/mbedtls/libduckdb_mbedtls.a")
@@ -14,10 +22,12 @@
   set(OPENSSL_USE_STATIC_LIBS TRUE)
 endif()
 
-find_package(OpenSSL REQUIRED)
-find_package(CURL REQUIRED)
-include_directories(${OPENSSL_INCLUDE_DIR})
-include_directories(${CURL_INCLUDE_DIRS})
+if(NOT EMSCRIPTEN AND NOT HTTPFS_WASI)
+  find_package(OpenSSL REQUIRED)
+  find_package(CURL REQUIRED)
+  include_directories(${OPENSSL_INCLUDE_DIR})
+  include_directories(${CURL_INCLUDE_DIRS})
+endif()
 
 include_directories(src/include
                     ${DUCKDB_MODULE_BASE_DIR}/third_party/httplib)
@@ -29,8 +39,11 @@
 set(PARAMETERS "-warnings")
 build_loadable_extension(httpfs ${PARAMETERS} ${EXTENSION_SOURCES})
 
-if(EMSCRIPTEN)
+if(EMSCRIPTEN OR HTTPFS_WASI)
   target_link_libraries(httpfs_loadable_extension duckdb_mbedtls)
+  if(HTTPFS_WASI)
+    target_link_libraries(httpfs_extension duckdb_mbedtls)
+  endif()
 else()
   # Link dependencies into extension
   target_link_libraries(httpfs_loadable_extension ${CURL_LIBRARIES})
